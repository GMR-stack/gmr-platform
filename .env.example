# Copy this to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL=

# --- This site's own Supabase project (auth, users, GMR reports) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cardlogue app's Supabase project (separate project — used server-side
#     only, to write to its `subscriptions` table after a team payment) ---
CARDLOGUE_SUPABASE_URL=
CARDLOGUE_SUPABASE_SERVICE_ROLE_KEY=

# --- PortOne (payment gateway) — Korea leg of the Cardlogue team plan ---
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# --- Paddle (payment gateway) — international leg of the Cardlogue team plan ---
# "sandbox" or "live" — required, the app fails to start if unset so it can
# never silently run against the wrong Paddle account.
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
PADDLE_SEAT_UNIT_PRICE_USD_CENTS=
# From Paddle dashboard > Developer Tools > Notifications, after registering
# this app's /api/paddle/webhook URL as a notification destination.
PADDLE_WEBHOOK_SECRET=
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=

# --- PayPal (GMR report subscriptions) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
VITE_PAYPAL_PLAN_ID=

# --- Admin notification emails ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Economic calendar data ---
FMP_API_KEY=

PORT=5000
NODE_ENV=development
